# Groq LLM Configuration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Database (Default uses SQLite for instant local zero-config execution; set for PostgreSQL)
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/it_support
DATABASE_URL=sqlite:///./it_support.db

# Security
SECRET_KEY=it-support-portal-super-secret-jwt-key-2026-production-ready
ACCESS_TOKEN_EXPIRE_MINUTES=1440
